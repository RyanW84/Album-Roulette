@model List<AlbumRoulette.Models.Album>
@{
    ViewData["Title"] = "Browse All 500";
}

<style>
    .browse-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
    .browse-header h1 { 
        font-size: 2rem; 
        font-weight: 900;
        background: linear-gradient(135deg, var(--text) 0%, var(--text-muted) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .browse-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .spin-cta { 
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%); 
        color: #fff; 
        text-decoration: none; 
        padding: 0.6rem 1.4rem; 
        border-radius: 50px; 
        font-weight: 700; 
        font-size: 0.9rem;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 15px rgba(230, 57, 70, 0.3);
        border: none;
        cursor: pointer;
    }
    .spin-cta:hover { 
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(230, 57, 70, 0.4);
    }
    .clear-all-btn {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #fff;
        padding: 0.6rem 1.4rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.9rem;
        border: none;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }
    .clear-all-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
    }
    .clear-all-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
    }
    .filters { display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap; align-items: center; }
    .search-box { 
        flex: 1; 
        min-width: 200px; 
        background: rgba(28, 28, 38, 0.6);
        border: 1px solid var(--border);
        border-radius: 8px; 
        padding: 0.6rem 1rem; 
        color: var(--text); 
        font-size: 0.9rem; 
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        backdrop-filter: blur(10px);
    }
    .search-box:focus { 
        border-color: var(--accent);
        box-shadow: 0 0 12px rgba(230, 57, 70, 0.2);
        background: rgba(28, 28, 38, 0.8);
    }
    .search-box::placeholder { color: rgba(136, 136, 136, 0.6); }
    .decade-btn { 
        background: rgba(28, 28, 38, 0.6);
        border: 1px solid var(--border); 
        color: var(--text-muted); 
        padding: 0.4rem 0.9rem; 
        border-radius: 50px; 
        font-size: 0.8rem; 
        font-weight: 600; 
        cursor: pointer; 
        transition: all 0.2s;
        backdrop-filter: blur(10px);
    }
    .decade-btn:hover { 
        background: rgba(230, 57, 70, 0.1);
        border-color: var(--accent);
        color: var(--accent);
        transform: translateY(-1px);
    }
    .decade-btn.active { 
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
        border-color: var(--accent); 
        color: #fff;
        box-shadow: 0 4px 12px rgba(230, 57, 70, 0.3);
    }
    .results-count { 
        color: var(--text-muted); 
        font-size: 0.85rem; 
        margin-bottom: 1rem;
        transition: color 0.2s;
    }
    .chosen-count {
        display: inline-block;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.75rem;
        margin-left: 0.5rem;
    }
    .album-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); 
        gap: 1rem;
    }
    .album-row { 
        background: rgba(28, 28, 38, 0.6);
        border: 1px solid var(--border); 
        border-radius: 10px; 
        padding: 1rem;
        display: flex; 
        align-items: center; 
        gap: 0.85rem; 
        transition: all 0.3s;
        cursor: pointer;
        backdrop-filter: blur(10px);
        position: relative;
    }
    .album-row:hover { 
        border-color: var(--accent);
        background: rgba(28, 28, 38, 0.9);
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(230, 57, 70, 0.15);
    }
    .album-row.hidden { display: none; }
    .album-row.chosen {
        border-color: #10b981;
        background: rgba(16, 185, 129, 0.05);
    }
    .album-row.chosen::before {
        content: '✓';
        position: absolute;
        top: 4px;
        right: 8px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 900;
    }
    .rank-num { 
        font-size: 1.2rem; 
        font-weight: 900; 
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        min-width: 2.8rem; 
        text-align: right;
    }
    .row-info { flex: 1; min-width: 0; }
    .row-title { 
        font-weight: 700; 
        font-size: 0.9rem; 
        white-space: nowrap; 
        overflow: hidden; 
        text-overflow: ellipsis;
        transition: color 0.2s;
    }
    .album-row:hover .row-title { color: var(--accent-light); }
    .row-artist { 
        color: var(--text-muted); 
        font-size: 0.8rem; 
        margin-top: 0.1rem; 
        white-space: nowrap; 
        overflow: hidden; 
        text-overflow: ellipsis;
        transition: color 0.2s;
    }
    .album-row:hover .row-artist { color: var(--text); }
    .row-year { 
        color: var(--text-muted); 
        font-size: 0.78rem; 
        min-width: 2.5rem; 
        text-align: right;
        transition: color 0.2s;
    }
    .album-row:hover .row-year { color: var(--text); }
    .no-results { 
        text-align: center; 
        padding: 3rem; 
        color: var(--text-muted); 
        display: none;
        border: 1px dashed var(--border);
        border-radius: 10px;
        background: rgba(28, 28, 38, 0.3);
    }
</style>

<div class="browse-header">
    <h1>All 500 Albums</h1>
    <div class="browse-actions">
        <a href="/spin" class="spin-cta">🎲 Spin Random</a>
        <button class="clear-all-btn" id="clear-all-btn" onclick="clearAll()" disabled>🔄 Clear All</button>
    </div>
</div>

<div class="filters">
    <input class="search-box" id="search" type="text" placeholder="🔍  Search album or artist..." oninput="filterAlbums()" />
    <button class="decade-btn active" onclick="setDecade(null, this)">All</button>
    @{
        var decades = Model.Select(a => a.Year / 10 * 10).Distinct().OrderBy(d => d).ToList();
        foreach (var d in decades)
        {
            <button class="decade-btn" onclick="setDecade(@d, this)">@(d)s</button>
        }
    }
</div>

<div class="results-count" id="count">Showing all 500 albums<span class="chosen-count" id="chosen-count" style="display: none;">0 chosen</span></div>

<div class="album-grid" id="grid">
    @foreach (var album in Model)
    {
        <div class="album-row" data-title="@album.AlbumTitle.ToLower()" data-artist="@album.Artist.ToLower()" data-decade="@(album.Year / 10 * 10)" data-rank="@album.Rank">
            <div class="rank-num">#@album.Rank</div>
            <div class="row-info">
                <div class="row-title">@album.AlbumTitle</div>
                <div class="row-artist">@album.Artist</div>
            </div>
            <div class="row-year">@album.Year</div>
        </div>
    }
</div>

<div class="no-results" id="noResults">No albums match your search.</div>

<script>
    const CHOSEN_STORAGE_KEY = 'albumRoulette_chosenAlbums';
    let activeDecade = null;

    function getChosenAlbums() {
        const data = localStorage.getItem(CHOSEN_STORAGE_KEY);
        return data ? JSON.parse(data) : [];
    }

    function updateChosenDisplay() {
        const chosen = getChosenAlbums();
        const clearBtn = document.getElementById('clear-all-btn');
        const chosenCountSpan = document.getElementById('chosen-count');
        
        // Update chosen count display
        if (chosen.length > 0) {
            chosenCountSpan.textContent = `${chosen.length} chosen`;
            chosenCountSpan.style.display = 'inline-block';
            clearBtn.disabled = false;
        } else {
            chosenCountSpan.style.display = 'none';
            clearBtn.disabled = true;
        }
        
        // Update album rows
        document.querySelectorAll('.album-row').forEach(row => {
            const rank = parseInt(row.dataset.rank);
            if (chosen.includes(rank)) {
                row.classList.add('chosen');
            } else {
                row.classList.remove('chosen');
            }
        });
    }

    function clearAll() {
        if (confirm('Are you sure you want to clear all chosen albums?')) {
            localStorage.removeItem(CHOSEN_STORAGE_KEY);
            updateChosenDisplay();
        }
    }

    function setDecade(decade, btn) {
        activeDecade = decade;
        document.querySelectorAll('.decade-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filterAlbums();
    }

    function filterAlbums() {
        const q = document.getElementById('search').value.toLowerCase().trim();
        const rows = document.querySelectorAll('.album-row');
        let visible = 0;
        rows.forEach(row => {
            const titleMatch = row.dataset.title.includes(q);
            const artistMatch = row.dataset.artist.includes(q);
            const decadeMatch = !activeDecade || parseInt(row.dataset.decade) === activeDecade;
            const show = (titleMatch || artistMatch) && decadeMatch;
            row.classList.toggle('hidden', !show);
            if (show) visible++;
        });
        const label = activeDecade ? `${activeDecade}s` : 'all decades';
        document.getElementById('count').textContent =
            q ? `${visible} album${visible !== 1 ? 's' : ''} matching "${q}" in ${label}`
              : activeDecade ? `${visible} albums from the ${label}` : `Showing all 500 albums`;
        document.getElementById('noResults').style.display = visible === 0 ? 'block' : 'none';
    }

    // Initialize on load
    window.addEventListener('load', updateChosenDisplay);

    // Listen for storage changes from other tabs
    window.addEventListener('storage', function(e) {
        if (e.key === CHOSEN_STORAGE_KEY) {
            updateChosenDisplay();
        }
    });
</script>
